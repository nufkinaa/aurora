# Aurora secrets. Copy this file to `.env` and fill in your own values —
# `.env` is gitignored, so nothing here ever reaches a repository.
# Real environment variables (e.g. set by pm2 or the shell) take precedence.

# Password for the /admin panel. Required for any admin access, even from
# localhost — with no password set, the admin panel stays disabled.
AURORA_ADMIN_PASSWORD=

# TMDB API key — optional and free (https://www.themoviedb.org/settings/api).
# Adds age ratings and upgrades trending/search for movies; everything else
# works without it.
TMDB_API_KEY=

# OpenRouter API key — optional (https://openrouter.ai/keys). Powers the
# "Pick for me" AI recommender; without a key the feature simply stays hidden.
OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# "Continue with Google" — optional, and split in two because Google splits it
# in two. Without keys, every Google button simply doesn't exist. The admin
# panel (Profiles tab → Sign-in rollout) live-checks whatever you configure.

# The NORMAL browser popup. Create an OAuth client of type "Web application"
# in Google Cloud Console and register your origins as redirect URIs, e.g.
#   http://localhost:4000/api/auth/google/web-callback
#   https://your-domain.example/api/auth/google/web-callback
# (Google does not allow raw LAN IPs here — devices that reach the server by
# IP automatically fall back to the code flow below, if configured.)
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=

# The "type this code on your phone" flow, used by the TV app and IP-address
# devices. Needs a separate OAuth client of type "TVs and Limited Input
# devices". Optional until the TV app ships its login.
GOOGLE_TV_CLIENT_ID=
GOOGLE_TV_CLIENT_SECRET=

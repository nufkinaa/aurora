# Secrets & machine-specific config — never commit these
.env
config.json

# Runtime state (caches, JSON stores, aria2 session)
data/

# Dependencies
node_modules/

# Old/backup APK builds (the published build public/aurora-tv.apk IS tracked)
public/aurora-tv-webview-backup.apk
dist/

# Signing keys
*.keystore
!tv-native/android/app/debug.keystore

# Legacy WebView TV app build output
tv-app/build/


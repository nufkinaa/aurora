<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The TV's home screen: Continue watching and Aurora's own row (HomeScreenModule.kt). -->
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />
    <uses-permission android:name="com.android.providers.tv.permission.READ_EPG_DATA" />
    <!-- Lets the home-screen refresh job (HomeScreenJob.kt) stay scheduled across
         a reboot. A normal permission: nothing is asked of the viewer, and no
         receiver in this app listens for the boot itself. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- "Silo S1 E3 is ready to watch" when a download lands (DownloadNotices.kt).
         Android 13+ asks the viewer once; earlier versions grant it as installed. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The in-app updater hands a downloaded APK to the system installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 12+: lets the app update ITSELF without the confirmation
         dialog (UpdaterModule.installQuietly). Ignored on older versions. -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- Optional, granted by the viewer: lets Aurora open itself again after
         a "Restart now" update (Android refuses a background start without it). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Android TV: shows in the leanback launcher, no touchscreen required -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Android 11+ package visibility: without these the YouTube app on the
         TV is invisible to Linking.canOpenURL / openURL, and "Open in YouTube"
         silently did nothing (2026-10-07). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="vnd.youtube" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" android:host="www.youtube.com" />
        </intent>
        <package android:name="com.google.android.youtube.tv" />
        <package android:name="com.google.android.youtube" />
    </queries>

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:banner="@drawable/banner"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="true"
      android:supportsRtl="true">
      <!-- icon AND banner are repeated on the ACTIVITY, not left on the
           application alone. The leanback launcher reads the launchable
           activity's own attributes: `aapt2 dump badging` reported
           `leanback-launchable-activity: ... icon='' banner=''` while the
           application carried both, so Google TV found nothing on the activity
           and fell back to the framework's default robot. That is why the tile
           stayed unbranded no matter how good the artwork was. -->
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:screenOrientation="landscape"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <!-- Links from the TV's home screen rows back into the app (homeScreen.ts). -->
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="aurora" android:host="open" />
        </intent-filter>
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent-filter>
      </activity>
      <!-- Serves the downloaded update (cache/updates/) to the package installer
           as a content:// URI — a file:// path is refused since Android 7. -->
      <!-- Hears the result of a quiet update (UpdateResultReceiver.kt). -->
      <receiver android:name=".UpdateResultReceiver" android:exported="false" />
      <!-- The QA harness's door (tools/tv-pixel-diff/PROTOCOL.md, ui/qa/QaReceiver.kt).
           Exported so an explicit `am broadcast -n` reaches it with the process cold;
           inert unless adb is enabled on the box AND the intent carries the token
           derived from this APK's own signing certificate. -->
      <receiver android:name=".ui.qa.QaReceiver" android:exported="true">
        <intent-filter>
          <action android:name="com.auroratv.QA" />
        </intent-filter>
      </receiver>
      <!-- Opens Aurora again after a "Restart now" update (RelaunchReceiver.kt). -->
      <receiver android:name=".RelaunchReceiver" android:exported="false">
        <intent-filter>
          <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
        </intent-filter>
      </receiver>
      <!-- Refreshes the TV's home-screen rows every few hours while the app is
           closed (HomeScreenJob.kt). Only the system's job scheduler can bind it. -->
      <service
        android:name=".HomeScreenJob"
        android:permission="android.permission.BIND_JOB_SERVICE"
        android:exported="true" />
      <!-- Read-only pictures for the TV's home-screen row (ArtProvider.kt). -->
      <provider
        android:name=".ArtProvider"
        android:authorities="${applicationId}.art"
        android:exported="true" />
      <provider
        android:name="androidx.core.content.FileProvider"
        android:authorities="${applicationId}.fileprovider"
        android:exported="false"
        android:grantUriPermissions="true">
        <meta-data
          android:name="android.support.FILE_PROVIDER_PATHS"
          android:resource="@xml/file_paths" />
      </provider>
    </application>
</manifest>

# Release-signing credentials for the Aurora TV APK.
# Copy to keystore.properties (same folder — it is gitignored) and fill in.
# Generate a keystore once with:
#   keytool -genkeypair -v -keystore app/aurora.keystore -alias aurora \
#     -keyalg RSA -keysize 2048 -validity 10000
storeFile=aurora.keystore
storePassword=
keyAlias=aurora
keyPassword=
